# Copy to .env and fill in real values. See README.md for what each does.

PORT=3000

MONGO_URI=mongodb://localhost:27017/media-processing
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos
MINIO_PUBLIC_URL=http://localhost:9000

# Leave unset to auto-detect (h264_nvenc -> h264_videotoolbox -> libx264)
VIDEO_ENCODER=
TRANSCODE_CONCURRENCY=2
TRANSCODE_JOB_CONCURRENCY=2

# gemini | openai | ollama
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

QDRANT_URL=
QDRANT_API_KEY=

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Only used by `npm run create:admin` — the single way to seed the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated DNS override, only needed if Node can't resolve
# mongodb+srv:// / Redis / MinIO hostnames on your network (e.g. some VPNs).
DNS_SERVERS=
